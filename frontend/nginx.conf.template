# Rendered to /etc/nginx/conf.d/default.conf at container start by the nginx
# image's envsubst entrypoint, so PORT and BACKEND_URL stay runtime settings
# instead of being baked into the image. Only $-names that exist in the
# environment are substituted, which is why nginx's own $uri / $host /
# $request_uri survive unexpanded.

# Render's internal hostnames are stable but the instance IPs behind them
# change between deploys. nginx resolves a literal proxy_pass host once at
# startup and caches it forever, so the frontend would keep proxying to a dead
# IP after every backend deploy. Going through a variable (below) forces
# re-resolution against this resolver instead.
#
# NGINX_LOCAL_RESOLVERS is exported by the image's own
# /docker-entrypoint.d/15-local-resolvers.envsh, which reads the nameservers
# out of /etc/resolv.conf. That script no-ops unless
# NGINX_ENTRYPOINT_LOCAL_RESOLVERS is set, which the Dockerfile does.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # streamChat.ts calls /api/chat as a relative URL, so the browser sees one
    # origin and the backend needs no CORS — the same trick vite.config.ts
    # pulls in dev.
    location /api/ {
        # BACKEND_URL must not end in a slash: $request_uri is the full
        # original path, so a trailing slash would send a doubled //api/chat.
        set $backend_url "${BACKEND_URL}";
        proxy_pass $backend_url$request_uri;

        proxy_http_version 1.1;

        # $proxy_host, not $host: it names the backend, which is what both an
        # internal hostname and a public *.onrender.com URL need to see —
        # the latter for TLS SNI and for Render's edge to route to the right
        # service. The original browser-facing host still goes out below.
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        # /api/chat is SSE. Buffering here would hold the whole answer back
        # until the stream closed, which is exactly the bug the dev proxy's
        # no-transform header avoids.
        proxy_buffering off;
        proxy_cache off;
        gzip off;

        # A slow answer can go minutes between tokens; the default 60s read
        # timeout would cut the stream.
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # Vite fingerprints everything under assets/, so it can never go stale.
    location /assets/ {
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # index.html names the fingerprinted bundles, so a cached copy would pin
    # the app to an old build.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
