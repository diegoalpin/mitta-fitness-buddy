# Copy to backend/.env and fill in. Never commit the filled-in file.
# Every variable below is read in src/config.ts and nowhere else.

# --- MCP server (required) ------------------------------------------------
# Your own deployment of https://github.com/diegoalpin/intervals-icu-mcp-server,
# holding your own Intervals.icu API key. Include the /mcp path.
MCP_SERVER_URL=https://your-mcp-server.example.com/mcp

# Must match MCP_BEARER_TOKEN on that server. Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=

# --- Inference provider ---------------------------------------------------
# "anthropic" (default) or "openrouter". Only the selected provider's key is
# required; the other is ignored entirely.
LLM_PROVIDER=anthropic

# Required when LLM_PROVIDER=anthropic. From console.anthropic.com
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5
# ANTHROPIC_MODEL=claude-sonnet-5

# Required when LLM_PROVIDER=openrouter. From openrouter.ai/keys
# OPENROUTER_API_KEY=
# Optional. Defaults to openrouter/free (the Free Router, which fails over
# across free tool-capable models). Pinning one free slug gets you throttled.
# OPENROUTER_MODEL=openrouter/free

# Optional. Caps one model turn. On a reasoning model the hidden reasoning
# tokens come out of this same budget, so a value sized for the answer alone
# gets spent thinking. Default 8192 — sized for free models, many of which
# reject a larger request outright.
# OPENROUTER_MAX_TOKENS=8192

# Optional. none|minimal|low|medium|high|xhigh|max. Unset by default, which
# leaves the model's own default in place. Only meaningful on a reasoning
# model; the Free Router mostly routes to models that ignore it.
# OPENROUTER_REASONING_EFFORT=

# --- Named option: GPT-5.6 Luna (paid) ------------------------------------
# A reasoning model with 1.05M context and 128K max output, at $0.10/$0.60 per
# million tokens (openrouter.ai/openai/gpt-5.6-luna). Tool calling is solid,
# which is the weak point of the free models. To use it, uncomment all four:
#
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-5.6-luna
# OPENROUTER_MAX_TOKENS=32000
# OPENROUTER_REASONING_EFFORT=low
#
# 32000 leaves room for reasoning plus a long table-heavy answer, well under
# the model's 128K ceiling. "low" suits a chat app — the model is built for
# latency-sensitive work, and a higher effort mostly buys thinking time you
# are waiting through. Raise it if answers are shallow on multi-step questions.

# --- Server ---------------------------------------------------------------
# Optional. Defaults to 8787. Hosts that inject PORT (Render, Fly) override it.
# PORT=8787

# Optional diagnostic. Set to 1 to log streamed content-block types.
# BACKEND_DEBUG_BLOCKS=0

# Optional. debug|info|warn|error, default info.
# info  = one line per request, plus tool calls and a per-answer summary.
# debug = adds a line per streamed text chunk. Loud, but shows text leaving
#         the server token by token.
# LOG_LEVEL=info
