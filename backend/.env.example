# Copy to backend/.env and fill in. Never commit the filled-in file.
# Every variable below is read in src/config.ts and nowhere else.

# --- MCP server (required) ------------------------------------------------
# Your own deployment of https://github.com/diegoalpin/intervals-icu-mcp-server,
# holding your own Intervals.icu API key. Include the /mcp path.
MCP_SERVER_URL=https://your-mcp-server.example.com/mcp

# Must match MCP_BEARER_TOKEN on that server. Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=

# --- Inference provider ---------------------------------------------------
# "anthropic" (default) or "openrouter". Only the selected provider's key is
# required; the other is ignored entirely.
LLM_PROVIDER=anthropic

# Required when LLM_PROVIDER=anthropic. From console.anthropic.com
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5
# ANTHROPIC_MODEL=claude-sonnet-5

# Required when LLM_PROVIDER=openrouter. From openrouter.ai/keys
# OPENROUTER_API_KEY=
# Optional. Defaults to openrouter/free (the Free Router, which fails over
# across free tool-capable models). Pinning one free slug gets you throttled.
# OPENROUTER_MODEL=openrouter/free

# --- Server ---------------------------------------------------------------
# Optional. Defaults to 8787. Hosts that inject PORT (Render, Fly) override it.
# PORT=8787

# Optional diagnostic. Set to 1 to log streamed content-block types.
# BACKEND_DEBUG_BLOCKS=0

# Optional. debug|info|warn|error, default info.
# info  = one line per request, plus tool calls and a per-answer summary.
# debug = adds a line per streamed text chunk. Loud, but shows text leaving
#         the server token by token.
# LOG_LEVEL=info
